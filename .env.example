# Copy to .env and adjust. Real environment variables always win over .env values.
# A different path can be given with ENV_FILE=/etc/wheel/wheel.env

# --- HTTP ---------------------------------------------------------------
# Listen address. Use 127.0.0.1:8080 when running behind nginx.
ADDR=127.0.0.1:8080
# Public origin, used for the share link shown in the UI.
# Leave empty to derive it from the incoming request.
BASE_URL=

# --- Database -----------------------------------------------------------
# Either set DATABASE_URL ...
DATABASE_URL=postgres://wheel:wheel@127.0.0.1:5432/wheel?sslmode=disable
# ... or leave it empty and set the parts below instead.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=wheel
# PGPASSWORD=wheel
# PGDATABASE=wheel
# PGSSLMODE=disable

DB_MAX_OPEN_CONNS=25
# Apply pending SQL migrations on start.
AUTO_MIGRATE=true

# --- Sessions -----------------------------------------------------------
COOKIE_NAME=wheel_sid
# Must be true when served over HTTPS.
COOKIE_SECURE=false
SESSION_DAYS=365

# --- Behaviour ----------------------------------------------------------
DEFAULT_SPIN_SECONDS=15
MIN_SPIN_SECONDS=3
MAX_SPIN_SECONDS=300
MAX_ENTRIES=500
# Delete play sessions untouched for this many days. 0 disables cleanup.
PLAY_RETENTION_DAYS=60

# --- Runtime ------------------------------------------------------------
LOG_LEVEL=info
# text or json
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=10s
