[Unit]
Description=Wheel spinning service
Documentation=https://github.com/Alexander-D-Karpov/wheel
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sanspie
Group=sanspie
WorkingDirectory=/home/sanspie/wheel
EnvironmentFile=/home/sanspie/wheel/.env
ExecStart=/home/sanspie/wheel/bin/wheel
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wheel

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
RestrictSUIDSGID=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
